# VISUALRIF environment variables — names only, never commit values.
# Copy to .env.local for local development; set real values in Vercel project settings.
#
# Vercel Web Analytics needs no keys (enabled in the Vercel dashboard).
#
# Without the Sanity variables the site renders its built-in content and /studio
# shows a configuration notice, so builds never depend on them.

# Sanity — public (safe in the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Sanity — server only. Never prefix with NEXT_PUBLIC_.
# Read token: viewer role, for draft content / Visual Editing (not used yet).
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Sanity write token (editor role) — local migration scripts only, added when
# content migration begins. Never set it in Vercel.
# SANITY_API_WRITE_TOKEN=

# Later phases will add variables here (Attio, Resend, Turnstile, Redis, Sentry, search verification).
